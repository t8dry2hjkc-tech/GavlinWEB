@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #0f1110;
  color: #f4f1ea;
  font-family: 'Inter', sans-serif;
  line-height: 1.6;
}

#wrapper {
  max-width: 1200px;
  margin: 0 auto;
  background: #151817;
}

header {
  padding: 30px 50px;
  border-bottom: 1px solid rgba(255,255,255,.12);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-family: 'Playfair Display', serif;
  font-size: 1.6em;
  font-weight: 700;
  color: #ffffff;
  text-decoration: none;
}

nav a {
  color: #d8d1c4;
  text-decoration: none;
  margin-left: 28px;
  font-size: .9em;
  letter-spacing: .08em;
  text-transform: uppercase;
}

nav a:hover {
  color: #ffffff;
}

.hero {
  min-height: 620px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
  align-items: center;
  padding: 70px 50px;
  background: linear-gradient(135deg, #151817 0%, #263431 100%);
}

.hero img {
  width: 100%;
  height: 520px;
  object-fit: cover;
  filter: grayscale(15%);
}

.eyebrow {
  color: #b89b5e;
  text-transform: uppercase;
  letter-spacing: .18em;
  font-size: .78em;
  font-weight: 700;
}

h1, h2, h3 {
  font-family: 'Playfair Display', serif;
}

h1 {
  font-size: 4em;
  line-height: 1.05;
  margin: 15px 0;
}

h2 {
  font-size: 2.6em;
  margin: 0 0 20px;
}

h3 {
  font-size: 1.5em;
  margin-bottom: 8px;
}

p {
  color: #d8d1c4;
}

.btn {
  display: inline-block;
  margin-top: 20px;
  padding: 12px 24px;
  border: 1px solid #b89b5e;
  color: #ffffff;
  text-decoration: none;
  letter-spacing: .08em;
  text-transform: uppercase;
  font-size: .82em;
}

.btn:hover {
  background: #b89b5e;
  color: #111;
}

main {
  padding: 60px 50px;
}

.section-intro {
  max-width: 760px;
  margin-bottom: 45px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

.card {
  background: #1e2321;
  border: 1px solid rgba(255,255,255,.1);
  padding: 22px;
}

.card img {
  width: 100%;
  height: 230px;
  object-fit: cover;
  margin-bottom: 15px;
}

.card a {
  color: #ffffff;
  text-decoration: none;
}

.card a:hover {
  color: #b89b5e;
}

.feature {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 45px;
  align-items: center;
  padding: 45px;
  background: #202927;
  margin-bottom: 35px;
}

.feature img {
  width: 100%;
  max-height: 430px;
  object-fit: cover;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30px;
}

.project-img {
  width: 100%;
  background: #fff;
  padding: 10px;
}

.process-list {
  background: #1e2321;
  padding: 30px;
  border-left: 5px solid #b89b5e;
}

.process-list li {
  margin-bottom: 12px;
  color: #d8d1c4;
}

.contact-box {
  background: #202927;
  padding: 45px;
  max-width: 760px;
}

.contact-box a {
  color: #b89b5e;
}

footer {
  padding: 30px 50px;
  border-top: 1px solid rgba(255,255,255,.12);
  color: #8f8a80;
  font-size: .85em;
}footer a {
  color: #b89b5e;
  text-decoration: none;
  margin-left: 10px;
}

footer a:hover {
  color: #ffffff;
